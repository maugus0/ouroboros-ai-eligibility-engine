# ======================================
# ELIGIBILITY & MATCHING AGENT - CONFIGURATION
# ======================================

# -------- Database (PostgreSQL) --------
# Option 1: DB_* prefix
DB_HOST=localhost
DB_NAME=ouroboros_eligibility_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_PORT=5432

# Option 2: POSTGRES_* prefix (Docker/CI compatibility)
# POSTGRES_HOST=localhost
# POSTGRES_DATABASE=ouroboros_eligibility_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_PORT=5432

# Connection pool
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_CONNECTION_TIMEOUT=30

# Docker PostgreSQL port (host-side)
DOCKER_POSTGRES_PORT=5433

# -------- Inter-Service Authentication --------
X_SERVICE_TOKEN=your-super-secret-service-token-here-change-this

# -------- LLM Configuration --------
# Primary: OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.1

# Fallback: Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1500

# Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

# -------- Scoring Configuration --------
# Program Match Weights (must sum to 100)
PROGRAM_WEIGHT_GPA=20
PROGRAM_WEIGHT_RELEVANCE=30
PROGRAM_WEIGHT_PREREQUISITES=25
PROGRAM_WEIGHT_RESEARCH=15
PROGRAM_WEIGHT_PRACTICAL=10

# Scholarship Match Weights (must sum to 100)
SCHOLARSHIP_WEIGHT_ELIGIBILITY=40
SCHOLARSHIP_WEIGHT_PREFERRED=30
SCHOLARSHIP_WEIGHT_FUNDING=20
SCHOLARSHIP_WEIGHT_COMPETITION=10

# Thresholds
MATCH_SCORE_THRESHOLD=50.0
HIGH_CONFIDENCE_THRESHOLD=75.0

# -------- Vector Search Configuration --------
EMBEDDING_DIMENSION=1536
VECTOR_SIMILARITY_TOP_K=5
VECTOR_SIMILARITY_THRESHOLD=0.7

# -------- Application --------
LOG_LEVEL=INFO
USE_MOCK_DATA=false
ALLOW_DB_FAILURE=false
